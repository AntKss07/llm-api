# ContextAI — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ------------------------------------------------------------
# REQUIRED — Get your key from https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# Optional — Gemini model and generation settings
# ------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30

# ------------------------------------------------------------
# Optional — Conversation context window
# How many previous messages to include in each LLM request.
# Increasing this gives the model more memory but costs more tokens.
# Note: this is a message count, not a token count.
# ------------------------------------------------------------
MAX_CONTEXT_MESSAGES=20

# ------------------------------------------------------------
# Optional — Flask development settings
# ------------------------------------------------------------
FLASK_DEBUG=false

